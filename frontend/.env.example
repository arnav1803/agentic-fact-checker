# Base URL of the fact-checker backend, with no trailing slash, e.g.
#   VITE_API_BASE_URL=https://your-name-fact-checker-api.hf.space
#
# Leave this EMPTY to run the UI against its built-in mock data (no backend
# required). Vite inlines VITE_* variables at build time, so this must be set
# in the hosting provider's environment before the production build runs —
# changing it later requires a redeploy.
VITE_API_BASE_URL=
